# docker compose 使用的密钥与配置。
# 用法：cp .env.example .env，逐项填写。.env 已在 .gitignore 中，不会被提交。
# 每个密码都单独生成，不要复用：openssl rand -base64 24

# ── 数据层 ──
# 只在 pgdata 卷首次初始化时生效；已有数据卷时见 docs/LAUNCH_CHECKLIST.md 的改密步骤
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=weibo
RABBITMQ_PASSWORD=

# ── 认证 ──
# 至少 32 字节：openssl rand -base64 48。生产环境必须新生成，不复用本地或历史值
JWT_SECRET=

# ── 图片存储（Cloudflare R2）──
# 生产用单独的 Access Key，权限只给 R2_BUCKET 这一个 bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=weibo-images
R2_PUBLIC_BASE_URL=

# ── AI（可选，留空则对应功能降级）──
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
AI_BUDGET_DAILY_USD=5.0

# ── 前端 ──
# 浏览器访问后端的地址，构建时内联进前端包；改了要重新 build（docker compose build frontend）
# 生产填 https://<API_DOMAIN>；WebSocket 地址由它推导（https → wss）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── 域名（生产，叠加 docker-compose.prod.yml 时使用）──
# 两个子域名的 DNS A 记录都指向服务器，80/443 对外开放，Caddy 自动申请 HTTPS 证书。
# 本地试跑反向代理可填 app.localhost / api.localhost（Caddy 用内置 CA 签本地证书）
APP_DOMAIN=
API_DOMAIN=
# 允许的前端 origin（CORS + WebSocket 握手），逗号分隔；生产填 https://<APP_DOMAIN>
CORS_ALLOWED_ORIGINS=http://localhost:3000
