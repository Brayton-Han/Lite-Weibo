spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/weibo
    username: postgres
    password: CHANGE_ME
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        format_sql: true
  flyway:
    enabled: true
  jackson:
    serialization:
      fail-on-empty-beans: false
  data:
    redis:
      host: localhost
      port: 6379
      timeout: 3000
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0
  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 20MB

server:
  port: 8080

jwt:
  secret: CHANGE_ME_USE_A_LONG_RANDOM_STRING

r2:
  accountId: "CHANGE_ME"
  accessKey: "CHANGE_ME"
  secretKey: "CHANGE_ME"
  bucket: "weibo-images"
  publicBaseUrl: "https://CHANGE_ME.r2.dev"

# 向量化（可选，以下均为默认值）。API key 只走环境变量 VOYAGE_API_KEY，不要写在这里。
# embedding:
#   voyage:
#     model: voyage-4
#     dimensions: 1024      # 必须与数据库 vector(N) 一致
#     batch-size: 128
#     max-attempts: 5       # 后台入库；搜索时的查询向量化固定快速失败（429 不重试）
#   search:
#     ef-search: 100        # HNSW 查询候选队列，越大召回越高、越慢（pgvector 默认 40）

# feed 推拉结合（可选，以下为默认值）。粉丝数达到阈值的作者转为拉模式，且不再回退。
# feed:
#   pull:
#     follower-threshold: 10000

# 重排（可选，以下均为默认值）。与 embedding 共用 VOYAGE_API_KEY 与 base-url。
# rerank:
#   voyage:
#     model: rerank-3       # 或 rerank-3-lite（更快更便宜）
#     timeout-ms: 2000      # 搜索请求里的读超时；超时或失败降级为第一阶段排序

# 生成层 Claude（可选，以下均为默认值）。API key 只走环境变量 ANTHROPIC_API_KEY，不要写在这里。
# claude:
#   timeout-ms: 60000
#   max-retries: 2          # SDK 自带重试：408/409/429/5xx 与连接错误
#   generation:
#     model: claude-haiku-5-5   # toy 项目语料少，Haiku 够用；效果不够再换 claude-sonnet-5-5
#     max-tokens: 16000

# 站内问答（可选，以下为默认值）。阈值针对 voyage-4 向量 top-1 余弦校准（EVAL.md「Day 14 · 拒答阈值」），换模型或检索方案须重新校准。
# ask:
#   top-k: 10
#   refusal:
#     min-top1-score: 0.40  # 低于它直接拒答、不调模型

# ─────────────────────────────────────────────────────────────
# 用法：cp application.yml.example application.yml，填入真实值。
#
# application.yml 已在 backend/.gitignore 中，不会被提交。
#
# ⚠️ jwt.secret 的旧值曾出现在 git 历史（b6df1316 等提交中），
#    本地务必换成新的随机串，且不要在任何部署环境复用旧值。
# ─────────────────────────────────────────────────────────────
